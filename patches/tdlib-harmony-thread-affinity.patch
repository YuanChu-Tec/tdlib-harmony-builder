 Status ThreadPthread::set_affinity_mask(id thread_id, uint64 mask) {
+#if defined(TD_HARMONYOS)
+  /* OpenHarmony has sched_setaffinity(pid_t) but not pthread_setaffinity_np; only used for current thread. */
+  (void)thread_id;
+  cpu_set_t cpuset;
+  CPU_ZERO(&cpuset);
+  for (int j = 0; j < 64 && j < CPU_SETSIZE; j++) {
+    if ((mask >> j) & 1) {
+      CPU_SET(j, &cpuset);
+    }
+  }
+  pid_t tid = static_cast<pid_t>(syscall(SYS_gettid));
+  int res = sched_setaffinity(tid, sizeof(cpuset), &cpuset);
+  if (res != 0) {
+    return OS_ERROR("Failed to set thread affinity mask");
+  }
+  return Status::OK();
+#elif TD_LINUX || TD_FREEBSD
