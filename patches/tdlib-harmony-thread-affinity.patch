+#if defined(TD_HARMONYOS)
+  (void)thread_id;
+  cpu_set_t cpuset;
+  CPU_ZERO(&cpuset);
+  pid_t tid = static_cast<pid_t>(syscall(SYS_gettid));
+  int res = sched_getaffinity(tid, sizeof(cpuset), &cpuset);
