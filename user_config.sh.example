#!/bin/bash
# ============================================
# TDLib for HarmonyOS 用户配置文件
# ============================================
# 
# 使用说明：
# 1. 复制此文件为 user_config.sh
# 2. 根据你的实际环境修改下面的路径
# 3. 程序会自动读取此配置文件
#
# cp user_config.sh.example user_config.sh
# 然后编辑 user_config.sh 填入你的路径
#
# ============================================

# ============================================
# HarmonyOS 开发环境路径
# ============================================

# HarmonyOS NDK 路径
# 这是 HarmonyOS Native Development Kit 的安装路径
# 通常位于: /path/to/harmony/ndk 或 ~/harmony/ndk
# 示例: /home/user/harmony/ndk 或 C:\Users\YourName\harmony\ndk
export OHOS_NDK="${OHOS_NDK:-}"

# HarmonyOS SDK 路径（可选）
# 如果 NDK 不在 SDK 目录下，可以单独设置
# 通常位于: /path/to/harmony/sdk
export OHOS_SDK="${OHOS_SDK:-}"

# HarmonyOS API 级别
# 根据你的目标设备选择，常见值: 9, 10, 11
# 默认: 9
export OHOS_API_LEVEL="${OHOS_API_LEVEL:-9}"

# ============================================
# 构建配置
# ============================================

# 并行编译任务数
# 根据你的 CPU 核心数设置，建议: CPU核心数 - 1
# 默认: 4
export PARALLEL_JOBS="${PARALLEL_JOBS:-4}"

# 构建模式
# Release: 发布版本（优化，体积小）
# Debug: 调试版本（包含调试信息）
# 默认: Release
export BUILD_MODE="${BUILD_MODE:-Release}"

# ============================================
# 目标架构
# ============================================

# 要编译的架构列表（用空格分隔）
# 可选值: arm64-v8a armeabi-v7a x86_64
# 默认: arm64-v8a
# 示例: export ARCHITECTURES=("arm64-v8a" "armeabi-v7a")
export ARCHITECTURES="${ARCHITECTURES:-arm64-v8a}"

# ============================================
# 路径配置（高级，通常不需要修改）
# ============================================

# 项目根目录（自动检测，通常不需要修改）
# export PROJECT_ROOT=""

# 源码下载目录（相对于项目根目录）
# 默认: src/downloads
# export DOWNLOAD_DIR=""

# 源码解压目录（相对于项目根目录）
# 默认: src/extracted
# export EXTRACT_DIR=""

# 构建目录（相对于项目根目录）
# 默认: build
# export BUILD_DIR=""

# 安装目录（相对于项目根目录）
# 默认: install
# export INSTALL_DIR=""

# 发布包目录（相对于项目根目录）
# 默认: dist
# export DIST_DIR=""

# 日志目录（相对于项目根目录）
# 默认: logs
# export LOGS_DIR=""

# ============================================
# 编译器配置（高级，通常不需要修改）
# ============================================

# 主机编译器（用于 ICU/protobuf 等的主机工具构建）
# 若设置，build_icu 等将使用此处指定的 CC/CXX 编译主机工具；否则使用系统默认
# 示例: export HOST_CC="gcc" HOST_CXX="g++"
# export HOST_CC=""
# export HOST_CXX=""

# C 编译器标志（额外）
# export EXTRA_CFLAGS=""

# C++ 编译器标志（额外）
# export EXTRA_CXXFLAGS=""

# 链接器标志（额外）
# export EXTRA_LDFLAGS=""

# ============================================
# 功能开关
# ============================================

# 是否启用 LTO (Link Time Optimization)
# 可以减小库文件体积，但会增加编译时间
# 默认: ON
export ENABLE_LTO="${ENABLE_LTO:-ON}"

# 是否编译静态库
# ON: 只编译静态库 (.a)
# OFF: 只编译动态库 (.so)
# BOTH: 同时编译静态库和动态库
# 默认: ON
export BUILD_STATIC="${BUILD_STATIC:-ON}"

# 是否编译动态库
# 默认: OFF
export BUILD_SHARED="${BUILD_SHARED:-OFF}"

# 是否跳过 TDLib 主机代码生成器（仅影响 TDLib 构建）
# 1/true: 跳过。使用源码中现有 API 文件（占位符或预生成）。主机生成器在 Windows/MSYS2 上可能失败时可设此选项。
# 0/false: 不跳过，正常构建 tl-parser/generate_common 并生成 API 文件。
# 默认: 0
# export TD_SKIP_HOST_GENERATOR="${TD_SKIP_HOST_GENERATOR:-0}"

# ============================================
# 配置说明
# ============================================
#
# 配置验证函数在 config.sh 中定义，会自动调用
# 运行以下命令验证配置：
#   source config.sh && validate_config
#
# 更多配置说明请查看: docs/USER_CONFIG.md
#
